{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lunagraph",
  "colors": {
    "primary": "#0a0a0a",
    "light": "#555555",
    "dark": "#0a0a0a"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Larken",
      "weight": 300,
      "source": "/fonts/Larken-Variable.woff2",
      "format": "woff2"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "download-alpha",
          "tutorial",
          "install-claude-code",
          "install-chrome-extension"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          {
            "group": "Connect an agent",
            "root": "guides/connect-an-agent",
            "pages": [
              "guides/connect-mcp"
            ]
          },
          "guides/connect-your-codebase",
          "guides/import-design-system",
          "guides/edit-component",
          "guides/custom-controls",
          "guides/send-a-prototype-link",
          "guides/chrome-extension-snapshot",
          "guides/bring-in-your-codebase",
          "guides/concepts",
          "guides/getting-started"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/tutorial"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://lunagraph.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://lunagraph.com/download"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/lunaborneo",
      "github": "https://github.com/nicepkg/lunagraph"
    }
  }
}
